<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Everything in oganesson & tennessine</title>
<meta name="description" content="Every change in oganesson and tennessine, patch by patch: what it does, where it comes from, and whether it is on.">
<meta property="og:title" content="Everything in oganesson & tennessine">
<meta property="og:description" content="Every change in oganesson and tennessine, patch by patch: what it does, where it comes from, and whether it is on.">
<meta property="og:type" content="website">
<meta name="theme-color" content="#0a0b10">
<link rel="canonical" href="https://dubna.zakius.xyz/everything.html">
<link rel="icon" href="img/favicon.png" type="image/png">
<style>
:root{--bg:#0a0b10;--bg2:#11131b;--card:#151824;--line:#252a3a;--text:#e8e9f0;--dim:#9aa0b4;--faint:#8288a0;
  --og:#ff9a5a;--ts:#b48cff;--glow:linear-gradient(100deg,#ffb36b 0%,#ff7fa8 45%,#a78bff 100%);
  --on:#5be3a1;--flag:#7cc4ff;--off:#8a90a6;--drop:#ff6b7f;--plan:#f4c95d;
  --mono:ui-monospace,"JetBrains Mono","SF Mono",Menlo,Consolas,monospace;--sans:system-ui,-apple-system,"Segoe UI",Inter,Roboto,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:150px}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit}
.wrap{max-width:1240px;margin:0 auto;padding:0 24px}
nav{border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;gap:20px;height:56px}
nav a{text-decoration:none;color:var(--dim);font-size:14px} nav a:hover{color:var(--text)}
nav b{font-family:var(--mono);white-space:nowrap}
header{padding:48px 0 28px}
h1{font-size:clamp(32px,4.4vw,52px);letter-spacing:-.025em;margin:0 0 10px;line-height:1.05}
h1 em{font-style:normal;background:var(--glow);-webkit-background-clip:text;background-clip:text;color:transparent}
.lede{color:var(--dim);max-width:760px;margin:0;font-size:17px}
.stats{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 16px;min-width:120px}
.stat b{display:block;font:700 26px/1.1 var(--mono)}
.stat span{color:var(--faint);font-size:12.5px}
.bar{position:sticky;top:0;z-index:4;background:rgba(10,11,16,.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding:12px 0}
.bar .wrap{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
input[type=search]{flex:1;min-width:220px;background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:10px 14px;color:var(--text);font:inherit;outline:none}
input[type=search]:focus{border-color:#4a5275}
.seg{display:inline-flex;background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:3px}
.seg button,.chipf{all:unset;cursor:pointer;padding:6px 12px;border-radius:7px;font-size:13px;font-weight:600;color:var(--dim)}
.seg button[aria-pressed=true]{background:var(--card);color:var(--text)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chipf{border:1px solid var(--line);border-radius:999px;padding:5px 11px;font-weight:500;display:inline-flex;gap:6px;align-items:center}
.chipf[aria-pressed=false]{opacity:.45}
.chipf i{width:8px;height:8px;border-radius:50%}
.layout{display:grid;grid-template-columns:230px 1fr;gap:32px;padding:28px 24px 80px}
aside{position:sticky;top:130px;align-self:start;max-height:calc(100vh - 150px);overflow:auto}
aside a{display:flex;justify-content:space-between;text-decoration:none;color:var(--dim);font-size:14px;padding:6px 10px;border-radius:8px}
aside a:hover{background:var(--card);color:var(--text)}
aside a span{font:12px var(--mono);color:var(--faint)}
.cat{margin-bottom:40px}
.cat h2{display:flex;align-items:baseline;gap:12px;font-size:24px;margin:0 0 4px;letter-spacing:-.01em}
.cat h2 small{font:13px var(--mono);color:var(--faint)}
.cat>p{color:var(--faint);margin:0 0 14px;font-size:14px}
.list{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--card)}
.it{display:grid;grid-template-columns:1fr auto;gap:4px 16px;padding:13px 18px;border-bottom:1px solid var(--line);margin-bottom:-1px}
.it:hover{background:#181c2a}
.t{font-weight:600;font-size:15px}
.w{grid-column:1/-1;color:var(--dim);font-size:14px}
.n{grid-column:1/-1;font-size:13px;color:var(--plan);}
.more{grid-column:1/-1;font-size:14px}
.n:before{content:"→ ";color:var(--faint)}
.meta{display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.b{font:11.5px var(--mono);padding:2px 8px;border-radius:6px;border:1px solid var(--line);color:var(--dim);white-space:nowrap}
.b.og{color:var(--og);border-color:rgba(255,154,90,.35)} .b.ts{color:var(--ts);border-color:rgba(180,140,255,.35)}
.b.own{background:var(--glow);color:#140f16;border:0;font-weight:600}
.s{font:11.5px var(--mono);padding:2px 8px;border-radius:6px;white-space:nowrap}
.s.on{color:var(--on);background:rgba(91,227,161,.1)} .s.flag{color:var(--flag);background:rgba(124,196,255,.1)}
.s.off{color:var(--off);background:rgba(138,144,166,.12)} .s.dropped,.s.to-drop{color:var(--drop);background:rgba(255,107,127,.1)}
.path{grid-column:1/-1;font:12px var(--mono);color:var(--faint)}
.empty{color:var(--faint);padding:40px;text-align:center;border:1px dashed var(--line);border-radius:14px}
[hidden]{display:none!important}
.skip{position:absolute;left:12px;top:-60px;z-index:10;padding:8px 14px;border-radius:8px;background:var(--card);border:1px solid var(--line)}
.skip:focus{top:10px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.ftoggle,#jump{display:none}
#jump{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:9px 10px;color:var(--text);font:inherit;flex:1;min-width:0}
.ftoggle{all:unset;cursor:pointer;padding:9px 14px;border:1px solid var(--line);border-radius:10px;font-size:14px;font-weight:600;color:var(--dim)}
a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--ts);outline-offset:2px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
mark{background:rgba(244,201,93,.25);color:inherit;border-radius:3px}
@media (max-width:900px){.layout{grid-template-columns:1fr}aside{display:none}
  .ftoggle,#jump{display:block}.bar:not(.open) .seg,.bar:not(.open) .chips{display:none}
  input[type=search]{flex-basis:100%;order:3}}
@media (max-width:700px){.it{grid-template-columns:1fr}.meta{justify-content:flex-start}}
.warn{display:flex;gap:18px;align-items:flex-start;background:linear-gradient(90deg,rgba(255,154,90,.08),rgba(180,140,255,.06));border:1px solid #3a3346;border-radius:16px;padding:22px 26px;margin:0 24px 40px}
.warn p{margin:0;color:var(--dim)} .warn b{color:var(--text)}
footer{padding:40px 0 60px;color:var(--faint);font-size:13.5px;border-top:1px solid var(--line)}
footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}

</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<nav><div class="wrap"><a href="index.html">← <b>oganesson · tennessine</b></a><span style="flex:1"></span><a href="index.html#compare">Compare</a><a href="install.html">Install</a><a href="releases.html">Releases</a></div></nav>
<header><div class="wrap">
  <h1>Everything, <em>patch by patch</em></h1>
  <p class="lede">Every change in both browsers: Helium's whole series as oganesson carries it, oganesson's own patches, and tennessine's patches on top of Vanadium and Titanium. Each one says what it does, where it comes from, and whether it's on, behind a flag, off by default or dropped. Most are Helium's and maintained there; Firefox Sync is Mozilla's library behind a small adapter; my own patches are mostly small switches.</p>
  <div class="stats" id="stats">__STATS__</div>
</div></header>

<div class="bar" role="search" hidden><div class="wrap">
  <select id="jump" aria-label="Jump to a section"></select>
  <button class="ftoggle" type="button" aria-expanded="false" aria-controls="br own st">Filters</button>
  <span id="results" class="sr" aria-live="polite"></span>
  <input type="search" id="q" aria-label="Search features, patches and origins" placeholder="Search features, patches, origins…  (press /)">
  <div class="seg" id="br" role="group" aria-label="Browser"><button data-v="all" aria-pressed="true">Both</button><button data-v="og" aria-pressed="false">oganesson</button><button data-v="ts" aria-pressed="false">tennessine</button></div>
  <div class="seg" id="own" role="group" aria-label="Origin"><button data-v="0" aria-pressed="true">All origins</button><button data-v="1" aria-pressed="false">Mine only</button></div>
  <div class="chips" id="st" role="group" aria-label="State">__CHIPS__</div>
</div></div>

<div class="wrap layout" style="padding-left:24px;padding-right:24px">
  <aside id="toc">__TOC__</aside>
  <main id="main">__MAIN__<div class="empty" hidden>Nothing matches.</div></main>
</div>

<div class="wrap"><div class="warn"><span aria-hidden="true">⚠</span><p><b>Highly volatile.</b> This is a personal project. Features change or disappear without notice, updates can break things, and development may stop at any time. Use it knowing that.</p></div></div>
<footer><div class="wrap">
  <span>oganesson · tennessine · dubna. Built on Helium, ungoogled-chromium, Vanadium, Titanium, Brave's importer and Chromium. Thank you all.</span>
  <span>Licenses: oganesson GPL-3.0-only · tennessine GPL-2.0-only · dubna GPL-2.0-only OR GPL-3.0-only.</span>
</div></footer>

<script>
// The build writes every item into the page, so it reads in full without JS;
// this only filters and highlights.
const state={q:'',br:'all',own:'0',st:new Set(['on','flag','off','dropped'])};
const esc=s=>s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const hl=(s,q)=>q?esc(s).replace(new RegExp('('+q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','ig'),'<mark>$1</mark>'):esc(s);
function render(){
  const q=state.q.trim().toLowerCase();
  let toc='';
  for(const sec of document.querySelectorAll('section.cat')){
    let n=0;
    for(const it of sec.querySelectorAll('.it')){const d=it.dataset;
      const show=(state.br==='all'||d.b===state.br||d.b==='both')&&(state.own==='0'||d.own)&&state.st.has(d.s)&&(!q||d.k.includes(q));
      it.hidden=!show;
      if(show){n++;for(const el of it.querySelectorAll('.t,.w,.n,.path'))el.innerHTML=hl(el.dataset.raw??=el.textContent,q)}}
    sec.hidden=!n;sec.querySelector('h2 small').textContent=n;
    if(n)toc+=`<a href="#${sec.id}">${esc(sec.querySelector('h2').firstChild.textContent)}<span>${n}</span></a>`}
  document.getElementById('toc').innerHTML=toc;
  const jump=document.getElementById('jump');
  jump.innerHTML='<option value="">Jump to a section</option>'+[...document.querySelectorAll('#toc a')].map(a=>`<option value="${a.hash.slice(1)}">${esc(a.firstChild.textContent)} (${a.lastChild.textContent})</option>`).join('');
  document.getElementById('results').textContent=`${document.querySelectorAll('.it:not([hidden])').length} items`;
  document.querySelector('.empty').hidden=!!toc;
}
document.querySelector('.bar').hidden=false;
if(matchMedia('(pointer:coarse)').matches)document.getElementById('q').placeholder='Search features, patches, origins…';
document.querySelector('.ftoggle').onclick=e=>{const open=document.querySelector('.bar').classList.toggle('open');e.target.setAttribute('aria-expanded',open)};
document.getElementById('jump').onchange=e=>{if(e.target.value)document.getElementById(e.target.value).scrollIntoView();e.target.value=''};
document.getElementById('q').oninput=e=>{state.q=e.target.value;render()};
for(const id of ['br','own'])document.querySelectorAll('#'+id+' button').forEach(b=>b.onclick=()=>{state[id]=b.dataset.v;document.querySelectorAll('#'+id+' button').forEach(x=>x.setAttribute('aria-pressed',x===b));render()});
document.querySelectorAll('#st .chipf').forEach(b=>b.onclick=()=>{const k=b.dataset.k;state.st.has(k)?state.st.delete(k):state.st.add(k);b.setAttribute('aria-pressed',state.st.has(k));render()});
render();
addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement.tagName!=='INPUT'){e.preventDefault();document.getElementById('q').focus()}});
</script>
</body>
</html>
