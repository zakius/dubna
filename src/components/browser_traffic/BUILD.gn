import("//testing/test.gni")

# Browser traffic's settings and rules (browser_traffic.h). Each browser wires
# its downloads to it.
component("browser_traffic") {
  sources = [
    "browser_traffic.cc",
    "browser_traffic.h",
  ]
  defines = [ "IS_BROWSER_TRAFFIC_IMPL" ]
  public_deps = [
    "//base",
    "//url",
  ]
  deps = [
    "//components/prefs",
    "//net",
  ]
}

test("browser_traffic_unittests") {
  sources = [ "browser_traffic_unittest.cc" ]
  deps = [
    ":browser_traffic",
    "//base/test:run_all_unittests",
    "//components/prefs:test_support",
    "//testing/gtest",
  ]
}
