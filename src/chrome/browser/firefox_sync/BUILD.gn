# Firefox Sync, shared by oganesson and tennessine through dubna. The protocol
# runs in the Sync library, built by each product's build-sync-lib.sh
# from dubna's rust/oganesson_sync. What depends on the browser around it
# (firefox_sync_platform.h) is in each product's
# //chrome/browser/firefox_sync/platform, which public_deps this target and is
# the one the browser depends on.
source_set("firefox_sync") {
  sources = [
    "autofill_adapter.cc",
    "autofill_adapter.h",
    "bookmarks_adapter.cc",
    "bookmarks_adapter.h",
    "firefox_sync_platform.h",
    "firefox_sync_service.cc",
    "firefox_sync_service.h",
    "firefox_sync_service_factory.cc",
    "firefox_sync_service_factory.h",
    "history_adapter.cc",
    "history_adapter.h",
    "passwords_adapter.cc",
    "passwords_adapter.h",
    "remote_tabs.cc",
    "remote_tabs.h",
    "sync_adapter.cc",
    "sync_adapter.h",
  ]
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    "//base",
    "//chrome/app:generated_resources",
    "//chrome/browser/autofill",
    "//chrome/browser/bookmarks",
    "//chrome/browser/history",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/sync",
    "//components/autofill/core/browser",
    "//components/bookmarks/browser",
    "//components/history/core/browser",
    "//components/history/core/common",
    "//components/keyed_service/core",
    "//components/os_crypt/async/browser",
    "//components/password_manager/core/browser",
    "//components/pref_registry",
    "//components/prefs",
    "//components/sessions",
    "//components/sync/protocol",
    "//components/sync_device_info",
    "//components/sync_sessions",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//ui/base",
  ]
}
