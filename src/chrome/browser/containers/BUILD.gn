import("//testing/test.gni")

# Tab containers, shared by oganesson and tennessine through dubna. What
# depends on the browser around it (containers_platform.h) is in each
# product's //chrome/browser/containers/platform, which public_deps this
# target and is the one the browser depends on.
source_set("containers") {
  sources = [
    "containers_platform.h",
    "containers_service.cc",
    "containers_service.h",
    "containers_service_factory.cc",
    "containers_service_factory.h",
    "containers_tabs.cc",
    "containers_tabs.h",
    "traffic_control_throttle.cc",
    "traffic_control_throttle.h",
  ]
  public_deps = [
    ":cleanup",
    ":core",
  ]
  deps = [
    "//base",
    "//chrome/app:generated_resources",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//components/pref_registry",
    "//components/prefs",
    "//components/sessions",
    "//content/public/browser",
    "//crypto",
    "//services/network/public/mojom",
    "//ui/base",
    "//url",
  ]
}

# The containers and Traffic Control's rules, without the browser.
source_set("core") {
  sources = [
    "container.cc",
    "container.h",
    "traffic_control.cc",
    "traffic_control.h",
  ]
  public_deps = [
    "//base",
    "//skia",
  ]
  deps = [
    "//components/url_matcher",
    "//url",
  ]
}

# Deleting the storage of containers nothing uses, without the browser.
source_set("cleanup") {
  sources = [
    "containers_cleanup.cc",
    "containers_cleanup.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    ":core",
    "//components/prefs",
  ]
}

# With Firefox Sync's containers adapter, which needs only the prefs: the
# firefox_sync target needs the whole browser.
test("containers_unittests") {
  sources = [
    "//chrome/browser/firefox_sync/containers_adapter.cc",
    "//chrome/browser/firefox_sync/containers_adapter.h",
    "//chrome/browser/firefox_sync/containers_adapter_unittest.cc",
    "//chrome/browser/firefox_sync/sync_adapter.cc",
    "//chrome/browser/firefox_sync/sync_adapter.h",
    "containers_cleanup_unittest.cc",
    "containers_unittest.cc",
  ]
  deps = [
    ":cleanup",
    ":core",
    "//base",
    "//base:i18n",
    "//components/prefs",
    "//testing/gtest",
    "//url",
  ]
}
