import("//testing/test.gni")

# Tab containers, shared by oganesson and tennessine through dubna: the
# containers and Traffic Control's rules, without the browser.
source_set("core") {
  sources = [
    "container.cc",
    "container.h",
    "traffic_control.cc",
    "traffic_control.h",
  ]
  public_deps = [
    "//base",
    "//skia",
  ]
  deps = [
    "//components/url_matcher",
    "//url",
  ]
}

test("containers_unittests") {
  sources = [ "containers_unittest.cc" ]
  deps = [
    ":core",
    "//base",
    "//base:i18n",
    "//testing/gtest",
    "//url",
  ]
}
