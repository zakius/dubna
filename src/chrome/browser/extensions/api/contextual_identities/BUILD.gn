import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions_core)

# Firefox add-ons (dubna's webextensions/README.md): Firefox's
# contextualIdentities API, over the browser's containers.
source_set("contextual_identities") {
  sources = [
    "contextual_identities_api.cc",
    "contextual_identities_api.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/containers",
    "//extensions/browser",
  ]

  deps = [
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//extensions/common",
    "//skia",
  ]
}
