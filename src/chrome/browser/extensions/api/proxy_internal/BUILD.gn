import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions_core)

# Firefox add-ons (dubna's webextensions/README.md): Firefox's
# proxy.onRequest and proxy.onError.
source_set("proxy_internal") {
  sources = [
    "firefox_proxy_config.cc",
    "firefox_proxy_config.h",
    "proxy_internal_api.cc",
    "proxy_internal_api.h",
  ]

  public_deps = [
    "//base",
    "//extensions/browser",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/proxy_resolver/public/mojom",
    "//url",
  ]

  deps = [
    "//content/public/browser",
    "//extensions/common",
  ]
}
