<grit-part>
  <message name="IDS_FIREFOX_XPI_UNSIGNED_PROMPT_WARNING" desc="In the prompt to install a Firefox add-on from a .xpi file that Mozilla hasn't signed: a warning, listed first among what the add-on can do.">
    Mozilla hasn't checked this add-on. Malicious add-ons can steal your private information or harm your computer. Add it only if you trust its source.
  </message>
  <message name="IDS_FIREFOX_XPI_UNVERIFIED" desc="On the extensions page, the warning on a Firefox add-on installed from a .xpi file that Mozilla hasn't signed.">
    This add-on could not be verified: Mozilla hasn't checked it. Proceed with caution.
  </message>
  <message name="IDS_FIREFOX_XPI_UNSIGNED_OVER_VERIFIED" desc="The error when a Firefox add-on from a .xpi file that Mozilla hasn't signed would replace an installed add-on with the same ID that was verified.">
    This add-on could not be installed because it has not been verified, and a verified add-on with the same ID is installed.
  </message>
</grit-part>
