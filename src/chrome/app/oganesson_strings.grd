<!-- Our own strings, with their own header, grit/oganesson_strings.h. In Chromium's
     generated_resources.grd each new string renumbered the ones after it, and every file that
     includes generated_resources.h (about 780) compiled again. The outputs are that file's: one
     .pak per locale, which chrome_repack_locales() packs with the rest (dubna's
     patches/own-strings.patch). Each browser lists its parts in its own oganesson_strings.grdp. -->
<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/oganesson_strings.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="oganesson_strings_af.pak" type="data_package" lang="af" />
    <output filename="oganesson_strings_am.pak" type="data_package" lang="am" />
    <output filename="oganesson_strings_ar.pak" type="data_package" lang="ar" />
    <output filename="oganesson_strings_as.pak" type="data_package" lang="as" />
    <output filename="oganesson_strings_az.pak" type="data_package" lang="az" />
    <output filename="oganesson_strings_be.pak" type="data_package" lang="be" />
    <output filename="oganesson_strings_bg.pak" type="data_package" lang="bg" />
    <output filename="oganesson_strings_bn.pak" type="data_package" lang="bn" />
    <output filename="oganesson_strings_bs.pak" type="data_package" lang="bs" />
    <output filename="oganesson_strings_ca.pak" type="data_package" lang="ca" />
    <output filename="oganesson_strings_cs.pak" type="data_package" lang="cs" />
    <output filename="oganesson_strings_cy.pak" type="data_package" lang="cy" />
    <output filename="oganesson_strings_da.pak" type="data_package" lang="da" />
    <output filename="oganesson_strings_de.pak" type="data_package" lang="de" />
    <output filename="oganesson_strings_el.pak" type="data_package" lang="el" />
    <output filename="oganesson_strings_en-GB.pak" type="data_package" lang="en-GB" />
    <output filename="oganesson_strings_en-US.pak" type="data_package" lang="en" />
    <output filename="oganesson_strings_es.pak" type="data_package" lang="es" />
    <output filename="oganesson_strings_es-419.pak" type="data_package" lang="es-419" />
    <output filename="oganesson_strings_et.pak" type="data_package" lang="et" />
    <output filename="oganesson_strings_eu.pak" type="data_package" lang="eu" />
    <output filename="oganesson_strings_fa.pak" type="data_package" lang="fa" />
    <output filename="oganesson_strings_fi.pak" type="data_package" lang="fi" />
    <output filename="oganesson_strings_fil.pak" type="data_package" lang="fil" />
    <output filename="oganesson_strings_fr-CA.pak" type="data_package" lang="fr-CA" />
    <output filename="oganesson_strings_fr.pak" type="data_package" lang="fr" />
