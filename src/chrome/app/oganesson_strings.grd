    <output filename="oganesson_strings_or.pak" type="data_package" lang="or" />
    <output filename="oganesson_strings_ro.pak" type="data_package" lang="ro" />
    <output filename="oganesson_strings_ru.pak" type="data_package" lang="ru" />
    <output filename="oganesson_strings_si.pak" type="data_package" lang="si" />
