    <output filename="oganesson_strings_sq.pak" type="data_package" lang="sq" />
    <output filename="oganesson_strings_sr-Latn.pak" type="data_package" lang="sr-Latn" />
    <output filename="oganesson_strings_sr.pak" type="data_package" lang="sr" />
    <output filename="oganesson_strings_sv.pak" type="data_package" lang="sv" />
    <output filename="oganesson_strings_sw.pak" type="data_package" lang="sw" />
    <output filename="oganesson_strings_ta.pak" type="data_package" lang="ta" />
    <output filename="oganesson_strings_te.pak" type="data_package" lang="te" />
    <output filename="oganesson_strings_th.pak" type="data_package" lang="th" />
