    <output filename="oganesson_strings_hr.pak" type="data_package" lang="hr" />
    <output filename="oganesson_strings_hu.pak" type="data_package" lang="hu" />
    <output filename="oganesson_strings_hy.pak" type="data_package" lang="hy" />
    <output filename="oganesson_strings_id.pak" type="data_package" lang="id" />
