    <output filename="oganesson_strings_ky.pak" type="data_package" lang="ky" />
    <output filename="oganesson_strings_lo.pak" type="data_package" lang="lo" />
    <output filename="oganesson_strings_lt.pak" type="data_package" lang="lt" />
    <output filename="oganesson_strings_lv.pak" type="data_package" lang="lv" />
