    <output filename="oganesson_strings_ar-XB.pak" type="data_package" lang="ar-XB" />
    <output filename="oganesson_strings_en-XA.pak" type="data_package" lang="en-XA" />
  </outputs>
  <translations>
    <file path="resources/oganesson_strings_pl.xtb" lang="pl" />
  </translations>
  <release seq="1">
    <!-- A part's file must be in this folder: grit reads it from the .grd's folder. -->
    <messages fallback_to_english="true">
      <part file="oganesson_strings.grdp" />
    </messages>
  </release>
</grit>
