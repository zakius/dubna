// Firefox add-ons (dubna's webextensions/README.md): Firefox's
// contextualIdentities API, read only, over the browser's containers
// (//chrome/browser/containers). create, update, remove and move are #103.
[
  {
    "namespace": "contextualIdentities",
    "description": "Firefox's contextualIdentities API: the browser's containers.",
    "types": [
      {
        "id": "ContextualIdentity",
        "type": "object",
        "description": "A container.",
        "properties": {
          "name": {"type": "string"},
          "icon": {"type": "string", "description": "Firefox's icon name."},
          "iconUrl": {"type": "string", "description": "Firefox's URL of the icon, which only Firefox loads."},
          "color": {"type": "string", "description": "Firefox's color name."},
          "colorCode": {"type": "string", "description": "The color, as #rrggbb."},
          "cookieStoreId": {"type": "string", "description": "firefox-container- and the container's id."}
        }
      }
    ],
    "functions": [
      {
        "name": "query",
        "type": "function",
        "description": "The user's containers, in their order.",
        "parameters": [
          {
            "name": "details",
            "type": "object",
            "properties": {
              "name": {"type": "string", "optional": true, "description": "Only the containers of this name."}
            }
          }
        ],
        "returns_async": {
          "name": "callback",
          "parameters": [
            {"name": "identities", "type": "array", "items": {"$ref": "ContextualIdentity"}}
          ]
        }
      },
      {
        "name": "get",
        "type": "function",
        "description": "A container by its cookieStoreId.",
        "parameters": [
          {"name": "cookieStoreId", "type": "string"}
        ],
        "returns_async": {
          "name": "callback",
          "parameters": [{"name": "identity", "$ref": "ContextualIdentity"}]
        }
      }
    ],
    "events": [
      {
        "name": "onCreated",
        "type": "function",
        "description": "A container was added to the user's list.",
        "parameters": [
          {
            "name": "changeInfo",
            "type": "object",
            "properties": {"contextualIdentity": {"$ref": "ContextualIdentity"}}
          }
        ]
      },
      {
        "name": "onUpdated",
        "type": "function",
        "description": "A container's name, icon or color changed.",
        "parameters": [
          {
            "name": "changeInfo",
            "type": "object",
            "properties": {"contextualIdentity": {"$ref": "ContextualIdentity"}}
          }
        ]
      },
      {
        "name": "onRemoved",
        "type": "function",
        "description": "A container was removed from the user's list.",
        "parameters": [
          {
            "name": "changeInfo",
            "type": "object",
            "properties": {"contextualIdentity": {"$ref": "ContextualIdentity"}}
          }
        ]
      }
    ]
  }
]
