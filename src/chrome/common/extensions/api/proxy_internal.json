// Firefox add-ons (dubna's webextensions/README.md): what an add-on's
// proxy.onRequest listeners answer (proxy_custom_bindings.js). Add-ons don't
// see this namespace.
[
  {
    "namespace": "proxyInternal",
    "description": "Reports what proxy.onRequest's listeners answered.",
    "functions": [
      {
        "name": "reportResult",
        "type": "function",
        "description": "The answer to the request with this ID: Firefox's ProxyInfo, a list of them, or null; or the message of the error the answer's promise rejected with.",
        "parameters": [
          {"name": "requestId", "type": "integer"},
          {"name": "result", "type": "any", "optional": true},
          {"name": "error", "type": "string", "optional": true}
        ]
      }
    ]
  }
]
