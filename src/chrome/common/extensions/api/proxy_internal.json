// Firefox add-ons (dubna's webextensions/README.md): what an add-on's
// proxy.onRequest listeners answer (proxy_custom_bindings.js). Add-ons don't
// see this namespace.
[
  {
    "namespace": "proxyInternal",
    "description": "Reports what proxy.onRequest's listeners answered.",
    "functions": [
      {
        "name": "reportResult",
        "type": "function",
        "description": "The answers of the listeners to the request with this ID, in their order: each Firefox's ProxyInfo, a list of them, or null; and the messages of the errors their promises rejected with.",
        "parameters": [
          {"name": "requestId", "type": "integer"},
          {"name": "answers", "type": "array", "items": {"type": "any"}},
          {"name": "errors", "type": "array", "items": {"type": "string"}}
        ]
      }
    ]
  }
]
