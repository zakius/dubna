   sources = [
+    "firefox_runtime_api.cc",
+    "firefox_runtime_api.h",
     "runtime_api.cc",
     "runtime_api.h",
     "runtime_api_delegate.cc",
--- a/extensions/browser/api/runtime/runtime_api.cc
