+std::optional<StoragePartitionConfig> GetCommittedStoragePartitionConfig(
+    NavigationEntry& entry) {
+  SiteInstanceImpl* site_instance = static_cast<NavigationEntryImpl&>(entry)
+                                        .root_node()
+                                        ->frame_entry->site_instance();
+  if (!site_instance) {
+    return std::nullopt;
+  }
+  return site_instance->GetSecurityPrincipal().GetStoragePartitionConfig();
+}
