# Firefox Sync's service for every profile, on the platforms that build it. The target is
# the product's //chrome/browser/firefox_sync/platform (see firefox_sync_platform.h).
--- a/chrome/browser/profiles/BUILD.gn
+++ b/chrome/browser/profiles/BUILD.gn
@@ -1123,6 +1123,10 @@ source_set("profiles_extra_parts_impl") {
   if (enable_offline_pages) {
     deps += [ "//chrome/browser/offline_pages" ]
   }
+
+  if (is_linux || is_android || is_win) {
+    deps += [ "//chrome/browser/firefox_sync/platform" ]
+  }
 }
 
 source_set("profile_downloader") {
--- a/chrome/browser/profiles/chrome_browser_main_extra_parts_profiles.cc
+++ b/chrome/browser/profiles/chrome_browser_main_extra_parts_profiles.cc
@@ -108,6 +108,9 @@
 #include "chrome/browser/feed/feed_service_factory.h"
 #include "chrome/browser/feedback/feedback_uploader_factory_chrome.h"
 #include "chrome/browser/file_system_access/file_system_access_permission_context_factory.h"
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_WIN)
+#include "chrome/browser/firefox_sync/firefox_sync_service_factory.h"
+#endif
 #include "chrome/browser/font_pref_change_notifier_factory.h"
 #include "chrome/browser/glic/public/glic_enabling.h"
 #include "chrome/browser/glic/public/glic_keyed_service_factory.h"
@@ -1044,6 +1047,9 @@ void ChromeBrowserMainExtraPartsProfiles::
 #if BUILDFLAG(IS_ANDROID)
   finds::FindsServiceFactory::GetInstance();
 #endif  // BUILDFLAG(IS_ANDROID)
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_WIN)
+  firefox_sync::FirefoxSyncServiceFactory::GetInstance();
+#endif
 #if !BUILDFLAG(IS_CHROMEOS) && !BUILDFLAG(IS_ANDROID)
   FirstRunServiceFactory::GetInstance();
 #endif
